# Copy to .env.local and fill in the values you need. Nothing here is required to
# run the site locally: the contact form degrades gracefully and the optional
# /api/contact endpoint stays inert until you add a database URL below.

# ── Contact form delivery via EmailJS (https://emailjs.com) ──────────────────
# All three are PUBLIC client ids (they ship to the browser by design). Restrict
# them at the source (EmailJS dashboard → allowed origins), not by hiding them.
# Leave blank and the form shows a "reach me by email" fallback instead of sending.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ── Optional: Google reCAPTCHA v3 bot check on the contact form ──────────────
# Public site key. Leave blank to disable the check entirely.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ── Optional: persist contact submissions server-side (choose ONE) ───────────
# The /api/contact route is a no-op until exactly one of these is set AND you
# uncomment the matching adapter in src/app/api/contact/route.ts. These are
# SECRET server-only values — never prefix them with NEXT_PUBLIC_.
#
# MongoDB (Atlas or self-hosted):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/portfolio
#
# Neon / any Postgres (connection string):
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
#
# Supabase (service role key stays server-side only):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
